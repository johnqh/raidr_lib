{
  "name": "@sudobility/raidr_lib",
  "version": "0.1.1",
  "description": "Business logic for raidr apps: catalog hooks, MCP connection docs, skill install helpers",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check-all": "bun run lint && bun run typecheck && bun run test:unit",
    "quick-check": "bun run lint && bun run typecheck",
    "verify": "bun run lint && bun run typecheck && bun run test:unit && bun run build",
    "dev": "bun run build:watch"
  },
  "keywords": [
    "raidr",
    "mcp",
    "typescript",
    "library"
  ],
  "author": "Sudobility Inc.",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@sudobility/di": "^1.5.66",
    "@sudobility/raidr_client": "^0.1.0",
    "@sudobility/raidr_types": "^0.1.2",
    "@sudobility/types": "^1.9.68",
    "@tanstack/react-query": "^5.90.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^4.0.4",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.0.4",
    "zustand": "^5.0.9"
  },
  "peerDependencies": {
    "@sudobility/di": "^1.5.66",
    "@sudobility/raidr_client": "^0.1.0",
    "@sudobility/raidr_types": "^0.1.2",
    "@sudobility/types": "^1.9.68",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnqh/raidr_lib.git"
  }
}
